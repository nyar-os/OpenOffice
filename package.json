{
    "name": "@wae/open-office",
    "description": "Thin all-in-one host bundling OpenWord, OpenExcel, OpenPPT, and OpenPDF into a single binary covering all Office formats",
    "keywords": ["office", "docx", "xlsx", "pptx", "pdf"],
    "private": true,
    "scripts": {
        "doc": "cargo doc --no-deps --all-features",
        "test": "cargo test --release",
        "fmt": "cargo fmt --all",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "u": "cargo upgrade --workspace"
    }
}
